# Copy to .env.local and fill in only the integrations you use.
# With every value left empty, /api/chat and /api/feedback return scripted demo content.

# Live LLM path (OpenRouter, OpenAI-compatible API). Empty -> demo replies and fixed demo feedback.
OPENROUTER_API_KEY=

# Optional model override. Empty -> google/gemini-2.0-flash-exp:free (default in the API routes).
OPENROUTER_MODEL=

# Supabase auth (Google OAuth) and session/message/feedback persistence.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
